# OpenRouter API Key for Multi-Tier LLM Fallback (Gemini Flash, Qwen 2.5, LLaMA 3.3 OSS)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Backend API Configuration
API_URL=http://127.0.0.1:8001
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# Authentication & Security
SECRET_KEY=your_secure_jwt_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=2

# Database Configuration (Auto-falls back to local SQLite if PostgreSQL is offline)
DATABASE_URL=postgresql+psycopg2://postgres:pwd@localhost:5432/postgres
DB_URI=postgresql://postgres:pwd@localhost:5432/langgraph

# Optional Vector DB & Tracing
QDRANT_CLIENT_URL=http://localhost:6333
LANGSMITH_TRACING=false
LANGGRAPH_API=false
