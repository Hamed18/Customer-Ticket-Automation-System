# ===================================================
# CUSTOMER TICKET AUTOMATION SYSTEM - ENVIRONMENT CONFIG
# ===================================================

# LLM Inference Providers
OPENROUTER_API_KEY=your_openrouter_api_key_here
GOOGLE_API_KEY=your_optional_google_gemini_api_key

# Backend API Configuration
API_URL=http://127.0.0.1:8001
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,https://your-app.vercel.app

# Authentication & Security
SECRET_KEY=generate_a_secure_random_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=2

# Database Configuration (Neon Serverless PostgreSQL or local fallback)
# Neon connection string example: postgresql://user:pass@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql+psycopg2://postgres:postgrespassword@localhost:5432/ticket_system
DB_URI=postgresql://postgres:postgrespassword@localhost:5432/langgraph

# Frontend Environment Variable (Set in Vercel or Frontend/.env)
# VITE_API_URL=https://your-render-backend-url.onrender.com

# Optional Vector DB & Tracing
QDRANT_CLIENT_URL=http://localhost:6333
LANGSMITH_TRACING=false
LANGGRAPH_API=false
